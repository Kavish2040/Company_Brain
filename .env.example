# company_brain — environment template
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Nothing auto-loads .env yet, so the `set -a` form above is what makes these
# visible to `uv run cb ...`. `.env` is gitignored; this file is not.
#
# The project runs with NONE of these set. Without credentials it selects
# deterministic offline providers (RuleBasedExtractor, HashingEmbedder,
# MemoryIndex, ExtractiveSynthesizer) and prints which it chose on every ingest,
# so a run is never silently degraded. See src/company_brain/app.py.


# ─── Live: read by the code today ────────────────────────────────────────────

# Setting BOTH switches the app off offline providers. Setting only one is
# treated as offline — a half-configured run is more confusing than an
# unconfigured one.

# Extraction (claude-sonnet-5) and synthesis (claude-opus-5).
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Embeddings: text-embedding-3-large at dimensions=1536.
# 1536 rather than the native 3072 because pgvector's HNSW index caps at 2000
# dimensions for the `vector` type. Changing this is a migration plus a full
# re-embed, not a config tweak.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google OAuth — for Drive and other Google APIs (read-only).
# Get these from Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Desktop app.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# No GOOGLE_REFRESH_TOKEN here on purpose: a refresh token comes out of a live
# browser consent flow, not something you paste in. Run `cb auth drive` once;
# it stores the refresh token at ~/.config/company_brain/tokens/gdrive.json
# (mode 0600), not in .env. `cb auth drive --revoke` deletes it locally.

# Google Drive sync scope.
# Required for `cb sync --connector gdrive` (or pass --folder <id> per run).
# The folder's Drive ID — the last path segment of its URL.
# Direct children only in v1 (non-recursive). No whole-account default to avoid
# accidentally ingesting unrelated or sensitive personal files.
GOOGLE_DRIVE_SCOPE_ID=

# Apollo — lead lookup for outreach drafts (people/match).
# https://developer.apollo.io/keys
#
# LOOKUP ONLY. Nothing in src/company_brain/outreach/ can send email: Apollo's
# sequence API is not wired, and /api/outreach/send records an approved
# dispatch without transmitting anything. Adding a send channel is a decision,
# not a config change.
#
# Unset (or COMPANY_BRAIN_OFFLINE=1) selects OfflineLeadSource, which returns
# the person's name and no contact details — never a fabricated address, since
# the reviewer's whole job is deciding whether to contact someone.
#
# `reveal_personal_emails` is never sent: it bills per call and returns
# personal addresses for people who did not offer them.
APOLLO_API_KEY=


# ─── Reserved: NOT read yet ──────────────────────────────────────────────────
#
# Listed so the shape is agreed before the code lands. Setting them today has
# no effect. Uncomment as each feature ships.

# Supabase — local stack. `supabase start` prints these; the local anon and
# service keys are fixed demo values, identical on every machine, and are not
# secrets. A hosted project's keys are.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for the index (psycopg, not supabase-py — the
# hybrid query needs pgvector, FTS, and CTEs that PostgREST cannot express).
# Port 54322 is the local stack's database; 6543 on a hosted project is the
# transaction pooler, which does not support prepared statements, so psycopg
# needs prepare_threshold=None there.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Storage bucket for the markdown store in deployed environments.
# Local dev uses LocalFsBackend so git provides the revision log and
# `git diff --exit-code` provides the acceptance test.
# COMPANY_BRAIN_STORE_BUCKET=company-brain-store
# COMPANY_BRAIN_STORE_PREFIX=

# Model overrides. Defaults live in app.py; set these only to pin or downgrade.
# COMPANY_BRAIN_EXTRACT_MODEL=claude-sonnet-5
# COMPANY_BRAIN_SYNTH_MODEL=claude-opus-5
# COMPANY_BRAIN_EMBED_MODEL=text-embedding-3-large

# Store root. Overriding this per-tier is how §6.2 physical tier separation
# works: a `restricted` node cannot be written into a non-restricted root.
# COMPANY_BRAIN_STORE=store
