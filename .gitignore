# NOTE: store/ is deliberately NOT ignored. The M1 acceptance test is
# `git diff --exit-code` over the generated markdown tree, and the extraction
# cache under store/_cache/ is committed on purpose (docs/ARCHITECTURE.md §4).

__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

.env
.env.*
!.env.example

# Supabase local stack state
supabase/.branches/
supabase/.temp/

.DS_Store

# Frontend
web/node_modules/
web/dist/

# A separate repo (getnao/sylph) that lives inside this directory.
# Committing it as a gitlink gives clones an empty folder pointing at
# a commit in another repository.
sylph/

# Mutable local demo state, not part of the graph.
#   _sim/   the simulated source system's own state (a fake Slack workspace)
#   _sync/  cursors, last-seen ids, and mirrored grants
#   _audit/ who saw what, when — wall-clock by definition
# All three are workflow state: invariant 2 lists acl_grants and cursors as the
# things NOT rebuildable from markdown. Committing them would churn on every
# demo run and make `git diff --exit-code` on the store meaningless.
#
# The audit log is ignored *here* and would not be in production, where it is
# the record a security reviewer asks for and belongs in an append-only store
# with retention (ARCHITECTURE §8.2, ROADMAP M5). A developer's local trail of
# their own demo runs is not that record.
store/_sim/
store/_sync/
store/_audit/
